# Modelo do .env de desenvolvimento. Copie para .env e preencha; o .env nunca vai para o git.
# Cada variável está explicada em docs/operacao/variaveis.md (o que faz, onde se configura, se é segredo).
# Homologação e produção não usam este arquivo: as variáveis ficam nos serviços do EasyPanel.

# --- Postgres local (docker-compose.yml) ------------------------------------------------------------
# Senhas usadas só na primeira subida do volume, para criar os papéis (db/preparacao/papeis.sql).
# Gere cada uma com: node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"
POSTGRES_PASSWORD=
SENHA_MIGRADOR=
SENHA_APP=
SENHA_PLATAFORMA=
SENHA_BACKUP=

# Porta do Postgres no seu computador (padrão 5435). Se mudar, ajuste a porta nas URLs abaixo.
PORTA_POSTGRES=

# Opcional: nome do projeto do docker compose (padrão banho-e-tosa). Útil com várias cópias do repositório.
# COMPOSE_PROJECT_NAME=banho-e-tosa

# --- Conexões com o banco ----------------------------------------------------------------------------
# App (papel app): sujeito ao RLS. Também usado pelo Better Auth.
# Formato: postgres://app:<SENHA_APP>@localhost:5435/banho_e_tosa
DATABASE_URL=

# Painel do administrador (papel plataforma).
# Formato: postgres://plataforma:<SENHA_PLATAFORMA>@localhost:5435/banho_e_tosa
DATABASE_URL_PLATAFORMA=

# Migrations e limpeza dos testes (papel migrador, dono das tabelas). O servidor do app nunca a lê.
# Só desenvolvimento e CI: na imagem, a credencial vai no arquivo /segredos/database_url_migrador (ADR 0015).
# Formato: postgres://migrador:<SENHA_MIGRADOR>@localhost:5435/banho_e_tosa
DATABASE_URL_MIGRADOR=

# Backup (papel backup, só leitura): usado pelos testes do papel. Em produção, só no serviço de backup.
# Formato: postgres://backup:<SENHA_BACKUP>@localhost:5435/banho_e_tosa
DATABASE_URL_BACKUP=

# --- Login (Better Auth) -----------------------------------------------------------------------------
# Segredo com pelo menos 32 caracteres aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# URL em que o app está aberto no navegador. Desenvolvimento: http://localhost:3000.
# Homologação e produção: https (o app não sobe sem isso).
BETTER_AUTH_URL=
# IPs ou faixas CIDR do proxy reverso, separados por vírgula. Vazio em desenvolvimento.
# Obrigatória em homologação e produção (faixa do proxy do EasyPanel; veja o checklist de lançamento).
BETTER_AUTH_TRUSTED_PROXIES=

# --- Suporte -----------------------------------------------------------------------------------------
# WhatsApp do suporte, mostrado na tela de empresa suspensa: só dígitos, com o código do país e o DDD
# (55 + DDD + número, tudo junto). Opcional em desenvolvimento; obrigatória em homologação e produção.
# O exemplo é fictício: o número real fica só no .env de cada máquina e nas variáveis do EasyPanel.
SUPORTE_WHATSAPP=5511900000000

# --- Ponta a ponta (Playwright) ----------------------------------------------------------------------
# Opcional: porta do app no teste (padrão 3000), quando outra coisa ocupa a 3000.
# PORTA_E2E=3000
