# Copie para .env e preencha. O .env nunca vai para o git.

# Senhas usadas pelo docker-compose ao criar o banco (só desenvolvimento).
POSTGRES_PASSWORD=
SENHA_MIGRADOR=
SENHA_APP=
SENHA_PLATAFORMA=

# Porta do Postgres no seu computador (padrão 5435).
PORTA_POSTGRES=

# Conexão do app (papel app): sujeita ao RLS.
# Formato: postgres://app:<SENHA_APP>@localhost:5435/banho_e_tosa
DATABASE_URL=

# Conexão do futuro painel do administrador (papel plataforma).
# Formato: postgres://plataforma:<SENHA_PLATAFORMA>@localhost:5435/banho_e_tosa
DATABASE_URL_PLATAFORMA=

# Conexão das migrations (papel migrador, dono das tabelas). O app não usa.
# Formato: postgres://migrador:<SENHA_MIGRADOR>@localhost:5435/banho_e_tosa
DATABASE_URL_MIGRADOR=
